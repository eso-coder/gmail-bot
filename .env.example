# Bu namuna fayl. Nusxa olib ".env" deb nomlang va o'z qiymatlaringizni yozing.
# Serverda (Railway) .env kerak emas — bu qiymatlar "Variables" bo'limiga yoziladi.

# @BotFather bergan token
BOT_TOKEN=

# Guruhda /chatid yozib oling
GROUP_CHAT_ID=

# Botga shaxsiy /myid yozib oling
ADMIN_USER_ID=

# Xat yuboriladigan Gmail manzili
GMAIL_ADDRESS=

# myaccount.google.com/apppasswords dan olingan 16 belgili parol
GMAIL_APP_PASSWORD=

# Faqat SERVERDA kerak: doimiy disk (volume) ulangan papka yo'li
# DATA_DIR=/data
